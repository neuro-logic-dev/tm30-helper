{
  "name": "tm30-helper",
  "version": "2.3.2",
  "description": "TM30 Helper — открывает tm30.immigration.go.th с автозаполнением аккаунта по ссылке tm30://",
  "main": "main.js",
  "author": "MO Estate",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --mac --win",
    "dist:mac": "electron-builder --mac",
    "dist:win": "electron-builder --win"
  },
  "build": {
    "appId": "com.moestate.tm30helper",
    "productName": "TM30 Helper",
    "publish": {
      "provider": "github",
      "owner": "neuro-logic-dev",
      "repo": "tm30-helper"
    },
    "files": [
      "main.js",
      "preload.js",
      "deeplink.js",
      "insert-sheet.js",
      "index.html",
      "window.html",
      "app.html",
      "portal-dates.js",
      "node_modules/**/*"
    ],
    "protocols": [
      {
        "name": "TM30 Helper Protocol",
        "schemes": [
          "tm30"
        ]
      }
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "identity": null,
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        }
      ]
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "runAfterFinish": true
    },
    "artifactName": "TM30-Helper.${ext}"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8",
    "exceljs": "^4.4.0"
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  }
}
