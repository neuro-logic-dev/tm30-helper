{
  "name": "tm30-helper",
  "version": "2.0.0",
  "description": "TM30 Helper — открывает tm30.immigration.go.th с автозаполнением аккаунта по ссылке tm30://",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --mac --win",
    "dist:mac": "electron-builder --mac",
    "dist:win": "electron-builder --win"
  },
  "build": {
    "appId": "com.moestate.tm30helper",
    "productName": "TM30 Helper",
    "publish": null,
    "files": [
      "main.js",
      "preload.js",
      "deeplink.js",
      "index.html",
      "window.html",
      "app.html"
    ],
    "protocols": [
      {
        "name": "TM30 Helper Protocol",
        "schemes": ["tm30"]
      }
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "identity": null,
      "target": [
        {
          "target": "dmg",
          "arch": ["universal"]
        }
      ]
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        }
      ]
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "runAfterFinish": true
    }
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8"
  }
}
